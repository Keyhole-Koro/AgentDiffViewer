{
  "name": "agent-diff-viewer",
  "version": "0.1.0",
  "description": "See which Claude Code or Codex session made each change in your git working tree, in a local diff viewer",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-diff": "dist/cli.js",
    "agent-diff-hook": "dist/hook-entry.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/viewer.html dist/",
    "prepack": "npm run build",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p .",
    "screenshots": "node scripts/screenshots.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "playwright": "^1.63.0",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Keyhole-Koro/AgentDiffViewer.git"
  },
  "homepage": "https://github.com/Keyhole-Koro/AgentDiffViewer#readme",
  "author": "Keyhole-Koro",
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ]
}
